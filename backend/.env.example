# ============================================================
# AIO Agent Platform — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ---- Database ----
# PostgreSQL connection URL (required)
DATABASE_URL=postgresql+asyncpg://agent_user:changeme@localhost:5435/aio_agent_platform

# ---- JWT Authentication ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# min 32-char secret is required; the app refuses to start without a proper secret
JWT_SECRET=change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- LLM 模型配置 ----
# 模型通过管理后台配置，不在 .env 中设置
# 在管理后台添加 LLM Provider 和 Model 后，为智能体绑定模型即可使用

# ---- Agent Configuration ----
AGENT_MAX_ITERATIONS=20
AGENT_TEMPERATURE=0.7
AGENT_TRUST_LEVEL=ask_dangerous  # ask_always | ask_dangerous | auto_all
AGENT_MEMORY_TOP_K=5

# ---- Sandbox Configuration ----
SANDBOX_IMAGE=aio-agent-platform/sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_SESSION_TTL=3600
SANDBOX_COMMAND_TIMEOUT=60
SANDBOX_WORKSPACE_QUOTA_MB=500
SANDBOX_NETWORK_DISABLED=true  # true = disable outbound network from sandbox (recommended)

# ---- Server ----
HOST=0.0.0.0
PORT=8100
CORS_ORIGINS=http://localhost:5273,http://localhost:3000
LOG_LEVEL=INFO

# ---- Object Storage (MinIO) ----
STORAGE_ENDPOINT=localhost:9010
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=skills
STORAGE_SECURE=false

# ---- Web UI ----
WEB_SECRET_KEY=change-me-in-production-0123456789

# ---- RAGFlow Knowledge Base ----
# 可选，可在管理后台修改（存入 system_config 表）
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=



