# ============================================================
# AIO Agent Platform — 环境变量配置
# 复制为 .env 并填写对应的值
# ============================================================

# ---- 数据库 ----
# PostgreSQL 连接地址（必填）
DATABASE_URL=postgresql+asyncpg://agent_user:changeme@localhost:5435/aio_agent_platform

# ---- JWT 认证 ----
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 密钥至少 32 个字符；未配置合法密钥时应用将拒绝启动
JWT_SECRET=change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- LLM 模型配置 ----
# 模型通过管理后台配置，不在 .env 中设置
# 在管理后台添加 LLM Provider 和 Model 后，为智能体绑定模型即可使用

# ---- 智能体配置 ----
AGENT_MAX_ITERATIONS=20
AGENT_TEMPERATURE=0.7
AGENT_TRUST_LEVEL=ask_dangerous  # ask_always=每次都询问 | ask_dangerous=仅危险操作询问 | auto_all=全部自动执行
AGENT_MEMORY_TOP_K=5

# ---- 沙箱配置 ----
SANDBOX_IMAGE=aio-agent-platform/sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_SESSION_TTL=3600
SANDBOX_COMMAND_TIMEOUT=60
SANDBOX_WORKSPACE_QUOTA_MB=500
SANDBOX_NETWORK_DISABLED=true  # true = 禁止沙箱访问外部网络（推荐）

# ---- 服务 ----
HOST=0.0.0.0
PORT=8100
CORS_ORIGINS=http://localhost:5273,http://localhost:3000
LOG_LEVEL=INFO
RELOAD=false  # true = 代码修改后自动重启（仅开发环境使用）
RELOAD_DELAY=5  # 变更检测轮询间隔（秒），间隔内的多次修改合并为一次重启

# ---- 对象存储（MinIO）----
STORAGE_ENDPOINT=localhost:9010
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=skills
STORAGE_SECURE=false

# ---- Web 界面 ----
WEB_SECRET_KEY=change-me-in-production-0123456789

# ---- RAGFlow 知识库 ----
# 可选，可在管理后台修改（存入 system_config 表）
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
