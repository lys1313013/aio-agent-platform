# Copy to .env and replace placeholders with your own connection settings.
LANGFUSE_BIND_HOST=0.0.0.0
LANGFUSE_PORT=13000
# Use a server IP or domain reachable by users when deploying remotely.
NEXTAUTH_URL=http://localhost:13000

# Initial administrator and project API keys.
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=

# External PostgreSQL: create the langfuse database first.
# URL-encode special characters in the database username and password.
DATABASE_URL='postgresql://YOUR_POSTGRES_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_POSTGRES_HOST:5432/langfuse'

# External Redis: Redis 7+ with maxmemory-policy=noeviction.
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=

# External MinIO: create the langfuse bucket first.
MINIO_ENDPOINT=http://YOUR_MINIO_HOST:9000
# Must be reachable by browsers and SDK clients.
MINIO_PUBLIC_URL=http://YOUR_MINIO_HOST:9000
MINIO_BUCKET=langfuse
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=

# Local ClickHouse and application secrets.
CLICKHOUSE_PASSWORD=
NEXTAUTH_SECRET=
SALT=
# Must be exactly 64 hexadecimal characters.
ENCRYPTION_KEY=
